## Backend do LLM: "ollama" ou "hf" ou "gguf" ou "api"
RAG_PROVIDER=ollama

## Ollama
## Dica: o Ollama geralmente usa tags (ex.: "llama3.1:8b"). Veja com: `rag models`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

## Hugging Face (modelo local via transformers)
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_DEVICE=-1
HF_MAX_NEW_TOKENS=512
## Pasta padrão para cache/download dos modelos HF (transformers)
HF_CACHE_DIR=E:\ComfyUI\models\LLM

## GGUF (llama.cpp)
## Use quando RAG_PROVIDER=gguf
GGUF_MODEL_PATH=
GGUF_N_CTX=4096
GGUF_N_GPU_LAYERS=0

## API providers (SDK oficial)
## Use quando RAG_PROVIDER=api
## API_PROVIDER: openai | mistral | google
API_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

## Embeddings (ollama: API Ollama em OLLAMA_BASE_URL; huggingface: sentence-transformers local)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text:latest

## Paths
DOCS_DIR=docs
CHROMA_DIR=.chroma

## RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
## (Opcional) reforço de instruções só no comando `rag ask` (CLI); a GUI tem campo equivalente
# RAG_EXTRA_INSTRUCTIONS=
